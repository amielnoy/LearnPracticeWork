# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules
.venv
__pycache__/
*.py[cod]
.pytest_cache/

# Playwright (tests/playwright/ itself is the component-test template, keep it)
test-results
playwright-report
blob-report
playwright/.cache
# Console logs, page snapshots and screenshots dropped by the Playwright MCP
# browser tools. One directory per debugging session, none of it reproducible
# and none of it worth reviewing.
.playwright-mcp

# Allure (results are generated per-run; report is generated from them)
allure-results
allure-report
allure-report-single

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local env overrides. The env files live in `env/`; unlike the committed ones,
# which hold only public build-time config, this is where anything you would not
# publish goes. These patterns carry no slash, so they match at any depth.
.env.local
.env.*.local

# The assembled static site. Built by the `build-pages` job in CI and by anyone
# reproducing it locally; never a source artefact.
_site
# Vercel CLI scratch: the prebuilt output the deploy workflow assembles, and
# the project link (`vercel link`) whose IDs belong in repository secrets.
.vercel

# Written into the repository root by Vercel's Python builder during
# `vercel build`: it derives these from requirements.txt, which is itself
# generated from server/uv.lock. All four are build output, not sources.
/requirements.txt
/pyproject.toml
/uv.lock
/_uv/

# BMAD skill packages. Rendered from `_bmad/` by the BMAD installer, not written
# by hand, and updated out of band — 2MB of generated content whose diffs say
# nothing about this repository. `_bmad/` itself is tracked, so the config and
# the customizations they are rendered from are shared.
.claude/skills/

# BMAD's per-developer install answers — a name, a language, a skill level.
# `_bmad/custom/.gitignore` already excludes its own `*.user.toml`; the one at
# the root of `_bmad/` is the same kind of file and was simply not covered.
_bmad/config.user.toml
