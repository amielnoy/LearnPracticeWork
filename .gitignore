# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# Playwright (tests/playwright/ itself is the component-test template, keep it)
test-results
playwright-report
blob-report
playwright/.cache
# Console logs, page snapshots and screenshots dropped by the Playwright MCP
# browser tools. One directory per debugging session, none of it reproducible
# and none of it worth reviewing.
.playwright-mcp

# Allure (results are generated per-run; report is generated from them)
allure-results
allure-report
allure-report-single

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local env overrides. Unlike the committed `.env` files, which hold only
# public build-time config, this is where anything you would not publish goes.
.env.local
.env.*.local

# The assembled static site. Built by the `build-pages` job in CI and by anyone
# reproducing it locally; never a source artefact.
_site
