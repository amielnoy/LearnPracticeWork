{
  "name": "@workspace/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:component && pnpm run test:api && pnpm run test:contract && pnpm run test:e2e",
    "test:unit": "playwright test --config=../playwright.config.mts --project=unit",
    "test:api": "playwright test --config=../playwright.config.mts --project=api",
    "test:contract": "playwright test --config=../playwright.config.mts --project=contract",
    "test:component": "playwright test --config=playwright-ct.config.ts",
    "test:e2e": "playwright test --config=playwright-e2e.config.ts --project=e2e-desktop --project=e2e-mobile --project=deck",
    "test:e2e:all": "playwright test --config=playwright-e2e.config.ts --workers=2",
    "test:browsers:all": "playwright install chromium webkit firefox",
    "test:browsers": "playwright install chromium",
    "report:allure": "allure awesome ../allure-results --output ../allure-report",
    "report:allure:single": "allure awesome ../allure-results --single-file --output ../allure-report-single",
    "report:allure:serve": "allure serve ../allure-results",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/api-zod": "workspace:*",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "typescript": "~5.9.2",
    "yaml": "^2.8.3",
    "zod": "catalog:"
  }
}
