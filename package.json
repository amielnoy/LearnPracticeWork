{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --filter \"./tests\" --if-present run typecheck",
    "test": "pnpm --filter @workspace/tests run test",
    "test:unit": "pnpm --filter @workspace/tests run test:unit",
    "test:component": "pnpm --filter @workspace/tests run test:component",
    "test:api": "pnpm --filter @workspace/tests run test:api",
    "test:contract": "pnpm --filter @workspace/tests run test:contract",
    "test:e2e": "pnpm --filter @workspace/tests run test:e2e",
    "report:allure": "pnpm --filter @workspace/tests run report:allure",
    "report:allure:serve": "pnpm --filter @workspace/tests run report:allure:serve"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "stripe": "^22.3.1",
    "stripe-replit-sync": "^1.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
